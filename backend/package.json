{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint",
    "copy-assets": "copyfiles -u 1 src/**/*.mmdb dist/",
    "db:seed": "npm run build && node dist/scripts/seed.js",
    "db:migrate": "npx prisma migrate deploy",
    "dev": "npx prisma generate && npm run db:seed && tsx watch ./src/app.ts",
    "build": "npx prisma generate --schema ./prisma/schema.prisma && tsc && npm run copy-assets",
    "start": "node dist/app.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@monorepo/shared": "1.0.0",
    "@prisma/client": "^6.18.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "chalk": "^4.1.2",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "maxmind": "^5.0.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-mailjet": "^6.0.11",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "rate-limit-redis": "^4.2.3",
    "redis": "^5.9.0",
    "stripe": "^19.3.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/maxmind": "^2.0.4",
    "@types/multer": "^2.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/redis": "^4.0.10",
    "@types/supertest": "^6.0.3",
    "copyfiles": "^2.4.1",
    "prisma": "^6.18.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}